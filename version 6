//@version=6
strategy("Gamas Strategy",
     overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10)

// =====================================================
// INPUTS
// =====================================================

fastLen = input.int(44, "Fast EMA")
slowLen = input.int(227, "Slow EMA")

slPoints  = input.float(100, "Stop Loss")
tp1Points = input.float(100, "TP1")
tp2Points = input.float(200, "TP2")
tp3Points = input.float(534, "TP3")

adxLength = input.int(12, "ADX Length")
adxFilter = input.float(25, "Minimum ADX")

crossLookback = input.int(1, "Crossover Lookback Bars")  // was 5

// =====================================================
// EMA CALCULATIONS
// =====================================================

fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)

plot(fastEMA, color=color.aqua,   linewidth=2)
plot(slowEMA, color=color.orange, linewidth=2)

// =====================================================
// TREND FILTERS
// =====================================================

slowTrendUp = slowEMA > slowEMA[5]

[diplus, diminus, adx] = ta.dmi(adxLength, adxLength)
strongTrend = adx > adxFilter

// =====================================================
// ENTRY CONDITIONS
// =====================================================

bullCross   = ta.crossover(fastEMA, slowEMA)
recentCross = ta.barssince(bullCross) <= crossLookback

// Prior bar touched EMA, this bar bounces off it with a strong close
barRange    = high - low
closePct    = barRange > 0 ? (close - low) / barRange : 0.5
strongClose = closePct >= 0.6   // close in top 40% of candle

pullbackEntry =
     fastEMA > slowEMA             and
     low[1] <= fastEMA[1] * 1.001  and  // prior bar touched EMA
     close   >  fastEMA            and  // this bar recovered above
     strongClose                   and  // not a doji/weak close
     close   >  open                    // green candle

longCondition =
     slowTrendUp and
     strongTrend and
     fastEMA > slowEMA and
     (recentCross or pullbackEntry)

if longCondition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

// =====================================================
// POSITION MANAGEMENT
// =====================================================

var bool tp1Hit = false
var bool tp2Hit = false

if strategy.position_size == 0
    tp1Hit := false
    tp2Hit := false

if strategy.position_size > 0

    entryPrice = strategy.position_avg_price

    tp1Price = entryPrice + tp1Points
    tp2Price = entryPrice + tp2Points
    tp3Price = entryPrice + tp3Points

    if high >= tp1Price
        tp1Hit := true
    if high >= tp2Price
        tp2Hit := true

    stopPrice =
         tp2Hit ? entryPrice + 100 :
         tp1Hit ? entryPrice :
         entryPrice - slPoints

    strategy.exit("TP1",    from_entry="Long", qty_percent=33, limit=tp1Price, stop=stopPrice)
    strategy.exit("TP2",    from_entry="Long", qty_percent=33, limit=tp2Price, stop=stopPrice)
    strategy.exit("Runner", from_entry="Long", qty_percent=34, limit=tp3Price, stop=stopPrice)

// =====================================================
// EXIT CONDITIONS
// =====================================================

bodyBelow =
     math.max(open, close) < fastEMA and
     math.max(open, close) < slowEMA

bearishConfirm =
     fastEMA < slowEMA and
     bodyBelow

if bearishConfirm
    strategy.close("Long")

// =====================================================
// VISUALS
// =====================================================

plotshape(longCondition and strategy.position_size == 0,
     style=shape.triangleup,
     color=color.lime,
     size=size.small,
     location=location.belowbar)

plotshape(recentCross and slowTrendUp and strongTrend,
     style=shape.triangleup,
     color=color.blue,
     size=size.tiny,
     location=location.belowbar,
     title="Cross Signal")

plotshape(bearishConfirm,
     style=shape.triangledown,
     color=color.red,
     size=size.small,
     location=location.abovebar)
